#!/usr/bin/env python3
"""PROTOTYPE git remote helper: git push/fetch against execd bundle endpoints.

URL: opensandbox://<host:port>/<repo path in sandbox>
Auth: OPENSANDBOX_EXECD_TOKEN -> X-EXECD-ACCESS-TOKEN. Plain http for the prototype;
a real helper resolves the endpoint and headers through GetEndpoint.
"""
import json, os, subprocess, sys, tempfile, urllib.error, urllib.parse, urllib.request

MAX = int(os.environ.get("OPENSANDBOX_GIT_MAX_BYTES", 256 << 20))
remote, url = sys.argv[1], sys.argv[2]
u = urllib.parse.urlparse(url)
BASE = f"http://{u.netloc}"
REPO = u.path or "/"
HDR = {"X-EXECD-ACCESS-TOKEN": os.environ.get("OPENSANDBOX_EXECD_TOKEN", "")}


def git(*a, inp=None, check=True):
    return subprocess.run(["git", *a], input=inp, capture_output=True, check=check)


def call(method, path, query=None, body=None, ctype=None):
    q = "?" + urllib.parse.urlencode(query, doseq=True) if query else ""
    req = urllib.request.Request(BASE + path + q, data=body, method=method, headers=dict(HDR))
    if ctype:
        req.add_header("Content-Type", ctype)
    try:
        with urllib.request.urlopen(req) as r:
            data = r.read(MAX + 1)
            if len(data) > MAX:
                raise RuntimeError("bundle exceeds size cap")
            return r.status, data
    except urllib.error.HTTPError as e:
        return e.code, e.read(65536)


def out(s=""):
    sys.stdout.write(s + "\n")
    sys.stdout.flush()


def local_has(sha):
    return git("cat-file", "-e", sha + "^{commit}", check=False).returncode == 0


def list_refs():
    st, data = call("GET", "/git/refs", {"path": REPO})
    if st != 200:
        raise RuntimeError(f"list failed: {st} {data.decode(errors='replace')}")
    return json.loads(data)


def cmd_list():
    r = list_refs()
    for ref in r["refs"]:
        out(f"{ref['sha']} {ref['name']}")
    if r.get("head"):
        out(f"@{r['head']} HEAD")
    out()


def cmd_fetch(first):
    wants = [first]
    while True:
        line = sys.stdin.readline().rstrip("\n")
        if not line:
            break
        wants.append(line)
    names = [w.split(" ", 2)[2] for w in (x for x in wants) if w.startswith("fetch ")]
    haves = [s for s in git("for-each-ref", "--format=%(objectname)").stdout.decode().split() if local_has(s)]
    body = json.dumps({"path": REPO, "refs": names, "haves": haves}).encode()
    st, data = call("POST", "/git/bundle/create", body=body, ctype="application/json")
    if st == 204:
        out()
        return
    if st != 200:
        raise RuntimeError(f"fetch failed: {st} {data.decode(errors='replace')}")
    with tempfile.NamedTemporaryFile(suffix=".bundle") as f:
        f.write(data); f.flush()
        git("bundle", "verify", f.name)
        git("bundle", "unbundle", f.name)
    out()


def cmd_push(first):
    specs = [first]
    while True:
        line = sys.stdin.readline().rstrip("\n")
        if not line:
            break
        specs.append(line)
    known = [r["sha"] for r in list_refs()["refs"] if local_has(r["sha"])]
    for line in specs:
        spec = line.split(" ", 1)[1]
        force = spec.startswith("+")
        src, dst = spec.lstrip("+").split(":", 1)
        if not src:
            out(f"error {dst} deletion is not supported"); continue
        full = git("rev-parse", "--symbolic-full-name", src, check=False).stdout.decode().strip()
        if not full.startswith("refs/"):
            out(f"error {dst} source must be a ref"); continue
        with tempfile.NamedTemporaryFile(suffix=".bundle") as f:
            r = git("bundle", "create", f.name, full, *["^" + k for k in known], check=False)
            if r.returncode != 0:
                out(f"error {dst} cannot build bundle: {r.stderr.decode().strip()}"); continue
            if os.path.getsize(f.name) > MAX:
                out(f"error {dst} bundle exceeds size cap"); continue
            q = {"path": REPO, "ref": f"{full}:{dst}"}
            if force:
                q["force"] = "true"
            st, data = call("POST", "/git/bundle/receive", q, body=open(f.name, 'rb').read(), ctype="application/x-git-bundle")
        if st == 200:
            out(f"ok {dst}")
        else:
            msg = data.decode(errors="replace").replace("\n", " ")
            out(f"error {dst} {st} {msg[:200]}")
    out()


def main():
    while True:
        line = sys.stdin.readline()
        if not line:
            return
        line = line.rstrip("\n")
        if line == "capabilities":
            out("fetch"); out("push"); out(f"refspec refs/heads/*:refs/remotes/{remote}/*")
            out("refspec refs/tags/*:refs/tags/*"); out()
        elif line.startswith("list"):
            cmd_list()
        elif line.startswith("fetch "):
            cmd_fetch(line)
        elif line.startswith("push "):
            cmd_push(line)
        elif line == "":
            return
        else:
            sys.stderr.write(f"unsupported command: {line}\n"); sys.exit(1)

main()
